# Freelance Market Intelligence — environment template
# Copy to .env and adjust. Never commit real secrets.

POSTGRES_USER=fmi
POSTGRES_PASSWORD=fmi_dev_password_change_me
POSTGRES_DB=fmi
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://fmi:fmi_dev_password_change_me@localhost:5432/fmi
# Optional SELECT-only URL for MCP analytics (python -m app.mcp). Prefer over DATABASE_URL.
DATABASE_URL_READONLY=

# Host-mapped Valkey (Compose service `valkey`, port 6380→6379). Protocol URL stays redis://
REDIS_URL=redis://localhost:6380/0
API_HOST=0.0.0.0
API_PORT=8000
# Compose api process user (default matches Dockerfile appuser). Override on Linux if
# bind-mounted ./backend or ./data are not writable by uid 1000: API_UID=$(id -u) etc.
# API_UID=1000
# API_GID=1000
# development|dev (local) | production|prod (rejects empty/* API_CORS_ORIGINS)
APP_ENV=development
# Both hostnames required: browser Origin for 127.0.0.1 ≠ localhost (CORS).
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_KEY=
# Required for PUT/DELETE /api/v1/ops/connectors/{key}/credentials (header X-Ops-Token)
# When OIDC_ENABLED=true, prefer Keycloak role admin; OPS_API_TOKEN remains break-glass (X-Ops-Token only).
OPS_API_TOKEN=
# Keycloak OIDC (ADR-009). Local Compose default: off.
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=fmi-frontend
# OIDC_JWKS_URL=
# When true, browser API calls need Bearer user|admin (API_KEY still bypasses for machines)
OIDC_REQUIRE_USER=false
# Frontend public OIDC (Compose default: off). Must match Keycloak base URL + realm.
# NEXT_PUBLIC_OIDC_ENABLED=false
# NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
# NEXT_PUBLIC_KEYCLOAK_REALM=fmi
# NEXT_PUBLIC_OIDC_CLIENT_ID=fmi-frontend
# Fernet key for DB-encrypted connector secrets (not the secrets themselves):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_MASTER_KEY=
CLASSIFICATION_MODE=hybrid
# rules | llm | hybrid
LLM_PROVIDER=none
# none | ollama | vllm
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=
VLLM_MODEL=
FX_HOURS_PER_DAY=8
# Browser → host-mapped API (must be reachable from the user's machine). In Compose
# use localhost:8000 (published port), never http://api:8000 in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-only SSR inside the frontend container. Compose defaults this to http://api:8000.
# Omit for local `next dev` (falls back to NEXT_PUBLIC_API_URL).
# INTERNAL_API_URL=http://api:8000
LOG_LEVEL=INFO
# Daily crawlers: prefer external cron once/day → backend/scripts/scheduler_tick.sh
# (see docs/ops/LOCAL.md). Local single-replica Compose: set ENABLE_SCHEDULER=true
# so the API runs one tick on boot then every SCHEDULER_INTERVAL_SECONDS.
# Multi-replica / prod: ENABLE_SCHEDULER=false on all replicas + cron.
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_SECONDS=86400
RATE_LIMIT_PER_MINUTE=180
# memory | redis (multi-replica; requires REDIS_URL → Valkey; falls back to memory)
RATE_LIMIT_BACKEND=memory
# Baseline API security headers (nosniff / DENY / strict-origin-when-cross-origin); false in tests if needed
SECURITY_HEADERS_ENABLED=true
# Public ATS board/site slugs (comma-separated, no secrets). See data/sources/catalog.json + Sources UI
# Public board tokens probed 2026-10-21 (HTTP 200 + payload). Expand per data/sources/catalog.json + Sources UI
GREENHOUSE_BOARDS=airbnb,stripe,gitlab,discord,cloudflare,figma,twilio,datadog,dropbox,coinbase,robinhood,mongodb,elastic,databricks,okta,pendo,duolingo,asana,block,anthropic,scaleai,brex,affirm,gusto,pinterest,reddit,coursera,khanacademy,lyft,waymo,spacex,janestreet,instacart,roblox,epicgames,mozilla,pagerduty,airtable,vercel,mercury,adyen,grafanalabs,natera,deliveroo,celonis,riotgames,intercom,getyourguide,chime,monzo,nintendo,fastly,sofi,launchdarkly,beamtherapeutics,billcom,n26,contentful,honeycomb,melio,flatironhealth,wise,generatebiomedicines,ginkgobioworks,circleci,cockroachlabs,planetscale,typeform,netlify,thefork,truelayer
LEVER_SITES=spotify,palantir,wealthfront,musixmatch
ASHBY_ORGS=notion,linear,vercel,openai,ramp,cursor,warp,granola,runway,supabase,mercor,harvey,sierra,cognition,perplexity,midjourney,snowflake,replit,plaid,miro,ashby,elevenlabs,temporal,webflow,sentry,docker,clickhouse,cohere,langchain,baseten,fireworks,lovable,modal,n8n,amplitude,hex,watershed,render,level,redis,workos,latchbio,anyscale,column,mesh,insitro,phantom,airbyte,posthog,moderntreasury,railway,satispay,docebo
# SmartRecruiters public company identifiers (no secrets)
SMARTRECRUITERS_COMPANIES=endava,ServiceNow,DeliveryHero,Wise,Allegro,Uber,Talan,Devoteam
# Personio public career board slugs (DACH tech; probed 2026-10-21). See data/sources/catalog.json + Sources UI
PERSONIO_COMPANIES=1komma5grad,chrono24,finanzguru,tado,kiwi,personio-gmbh,alcemy,researchgate,cloover,42watt,autonomous-teaming,aampere,cargoboard,getquin,getsafe
# Teamtailor career hosts (subdomain or custom domain; probed 2026-10-21). See data/sources/catalog.json + Sources UI
TEAMTAILOR_HOSTS=polestar.teamtailor.com,careers.oatly.com,storytel.teamtailor.com,krea.teamtailor.com,hedvig.teamtailor.com,doktor.teamtailor.com,schibsted.teamtailor.com,foodora.teamtailor.com,securitas.teamtailor.com,mindler.teamtailor.com,careers.voi.com,instabee.teamtailor.com,iqm.teamtailor.com,lunar.teamtailor.com,careers.acast.com,careers.nordhealth.com,rebtel.teamtailor.com,vipps.teamtailor.com,bambuser.teamtailor.com,detectify.teamtailor.com,netinsight.teamtailor.com,career.knowit.se,hiq.teamtailor.com,omegapoint.teamtailor.com,siili.teamtailor.com,pinetree.teamtailor.com
# Recruitee Careers Site slugs (keyless until 2027-02-10; probed 2026-10-21). See data/sources/catalog.json + Sources UI
RECRUITEE_SLUGS=jobs,personio,bunq,adjust,riverflex,holded,hostaway,simvia,intelic
# Pinpoint public postings subdomains (probed 2026-10-21; skip demo-like boards). See data/sources/catalog.json + Sources UI
PINPOINT_SUBDOMAINS=made-tech,accenture,bendingspoons,arm,freeagent,workwithus,imagination,confluence,hazelcast,smartthings
# Workable careers widget slugs (non-empty boards probed 2026-10-21). Back off on HTTP 429.
WORKABLE_SLUGS=huggingface,jasper,skillshare,riot,moneyfarm
# Workday CXS: tenant:wdN:siteSlug (comma-separated; probed 2026-10-21). Tech-leaning; skip retail megaboards. See data/sources/catalog.json + Sources UI
WORKDAY_TENANTS=nvidia:wd5:NVIDIAExternalCareerSite,redhat:wd5:jobs,intel:wd1:External,salesforce:wd12:External_Career_Site,adobe:wd5:external_experienced,paypal:wd1:jobs,micron:wd1:External,nxp:wd3:careers,analogdevices:wd1:External,cisco:wd5:Cisco_Careers,pfizer:wd1:PfizerCareers,workday:wd5:Workday,autodesk:wd1:Ext,tmobile:wd1:External,bbva:wd3:BBVA,paloaltonetworks:wd5:panwexternalcareers,crowdstrike:wd5:crowdstrikecareers,capitalone:wd12:Capital_One,mastercard:wd1:CorporateCareers,visa:wd5:Visa,amat:wd1:External,accenture:wd103:AccentureCareers,ms:wd5:External,citi:wd5:2,abb:wd3:External_Career_Page,philips:wd3:jobs-and-careers,amgen:wd1:Careers,roche:wd3:roche-ext,sanofi:wd3:SanofiCareers,msd:wd5:SearchJobs,gilead:wd1:gileadcareers,modernatx:wd1:M_tx,biibhr:wd3:external,geaerospace:wd5:GE_ExternalSite,gevernova:wd5:Vernova_ExternalSite,jj:wd5:JJ,ghr:wd1:lateral-us,swisscom:wd103:SwisscomExternalCareers,juliusbaer:wd3:External
# BambooHR public careers subdomains (CSV). Default flyio probed 200+jobs; many DC IPs still 503 — re-probe before expanding.
BAMBOOHR_COMPANIES=flyio

# Robert Half official XML feeds (joblist.roberthalf.com/IZ/general_rh-{cc}.xml). CSV of country suffixes.
ROBERT_HALF_COUNTRIES=ch,uk

# --- Demand Compass (discovery + focus) — ADR-007 + docs/manuals/RESEARCH.md ---
# Market scan topics: data/research/discovery_watchlist.json (seeded as kind=discovery).
# Personal bets: user Focus intents in the app (kind=focus).
# Optional explicit ops smoke only (never used by daily tick):
OPS_SMOKE_QUERY=
# Sync budgets (Settings / daily crawler Task 4):
SYNC_MAX_DISCOVERY_PER_TICK=12
SYNC_MAX_FOCUS_PER_TICK=10
SYNC_MAX_COLLECTOR_CALLS_PER_INTENT=5
SYNC_MAX_TOTAL_COLLECTOR_CALLS_PER_TICK=100

# Free public remote boards (prefer over paid Adzuna/Jooble/etc.)
HIMALAYAS_PAGE_LIMIT=40
DEVITJOBS_HOSTS=uk,com

# Adzuna Job Search API (https://developer.adzuna.com/) — leave empty to keep NEEDS_CREDENTIALS / non-runnable
# Same app_id/app_key works across country paths. For commercial/ongoing research, confirm licence with Adzuna (ToS).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
# Comma-separated; if empty, falls back to ADZUNA_COUNTRY then gb
ADZUNA_COUNTRIES=gb,us,au,it,de,ch,fr

# USAJOBS (https://developer.usajobs.gov/) — leave empty to keep non-runnable
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
# Optional OPM JobCategoryCode; recommended 2210 (IT Management) for denser federal IT intel
USAJOBS_JOB_CATEGORY_CODE=

# Reed.co.uk — ACTIVE via free public RSS (/jobs/rss). Optional REED_API_KEY switches
# collect() to the Jobseeker JSON search API (Basic auth: key as username, empty password).
# JSON is optional enrichment (salary/contract/employer); not required for ACTIVE status.
REED_API_KEY=

# France Travail Offres d'emploi v2 — register app at francetravail.io and subscribe to the API
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_SCOPE=api_offresdemploiv2 o2dsoffre

# Bundesagentur Jobsuche — X-API-Key (see jobsuche.api.bund.dev); leave empty to keep non-runnable
BUNDESAGENTUR_API_KEY=
BUNDESAGENTUR_LOCATION=Berlin

# Jooble (https://jooble.org/api/about)
JOOBLE_API_KEY=
JOOBLE_LOCATION=

# Findwork.dev Jobs API (https://findwork.dev/developers/) — Authorization: Token …
FINDWORK_API_KEY=
# Optional location filter (e.g. remote)
FINDWORK_LOCATION=

# Find a Job UK DWP (https://www.api.gov.uk/dwp/find-a-job/) — cross-gov api_id + api_key
FINDAJOB_DWP_API_ID=
FINDAJOB_DWP_API_KEY=
# Optional location for w= (e.g. London, Scotland, E1W)
FINDAJOB_DWP_LOCATION=

# Freelancer.com REST (https://developers.freelancer.com/) — OAuth access token
FREELANCER_OAUTH_TOKEN=
# Optional API base (sandbox: https://www.freelancer-sandbox.com/api)
FREELANCER_API_BASE=https://www.freelancer.com/api

# Upwork GraphQL (https://www.upwork.com/developer/) — approved OAuth token (partner review)
UPWORK_OAUTH_TOKEN=
# Optional organization id for X-Upwork-API-TenantId
UPWORK_TENANT_ID=

# Careerjet Partner API v4 (https://www.careerjet.com/partners/api/)
CAREERJET_API_KEY=
# Required by API: IP of the user/context triggering the search (publisher terms)
CAREERJET_USER_IP=
CAREERJET_USER_AGENT=FMI-MarketIntel/1.0
# Optional: comma-separated locale_code (default it_IT,de_DE,de_CH,fr_CH,fr_LU)
CAREERJET_LOCALES=
# CAREERJET_LOCATION=
# Contract filter: c = contract (default); leave empty in env to search all types
CAREERJET_CONTRACT_TYPE=c

# InfoJobs Developer API (https://developer.infojobs.net/) — HTTP Basic (client_id / client_secret)
INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=
# Optional country slug (see /dictionary/country), e.g. italia
INFOJOBS_COUNTRY=
INFOJOBS_MAX_RESULTS=50

# Dev Global Jobs free display API (https://devglobaljobs.com/developers) — no key; attribution required
# ISO2 lowercase CSV (default lu,bg for LU/BG coverage gaps)
# Optional local ADEM LU skills CSV for GET /api/v1/stats/adem/skills-summary
# ADEM_CSV_PATH=
DEVGLOBALJOBS_COUNTRIES=lu,bg

# okemprego free API (https://www.okemprego.com/pt/api) — no key; cite canonical URL
# ISO2 lowercase CSV (default pt; also br,ao). Collector filters category=it-data.
OKEMPREGO_COUNTRIES=pt

# Canada Job Bank open data (open.canada.ca monthly CSV, OGL-Canada) — no key
# Collector jobbank_ca resolves latest EN dump via CKAN; IT filter by NOC21 + keywords.

# Open Exchange Rates — optional FX overlay (Frankfurter/ECB stay primary)
OPEN_EXCHANGE_RATES_APP_ID=

# External cron (multi-replica): ENABLE_SCHEDULER=false and run:
#   API_URL=https://api.example ./backend/scripts/scheduler_tick.sh
# Optional: API_KEY=...

